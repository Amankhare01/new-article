@keyframes App-logo-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}


/* Parent container for news cards */
/* News card layout fix */
.card {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
  border-radius: 10px;
  overflow: hidden;
}

/* Make card body stretch */
.card-body {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

/* Keep button at the bottom */
.btn-primary {
  margin-top: auto;
}

/* Responsive Fix */
@media (max-width: 992px) { /* Tablets (max-width: 992px) */
  .col-lg-4 {
    flex: 0 0 50%; /* 2 cards per row */
    max-width: 50%;
  }
}

@media (max-width: 576px) { /* Phones (max-width: 576px) */
  .col-lg-4 {
    flex: 0 0 100%; /* 1 card per row */
    max-width: 100%;
  }
}
